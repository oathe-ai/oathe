{
  "description": "Oathe session lifecycle: the folder's board at SessionStart, lease heartbeat at Stop, frame note before compaction. Same three events exist verbatim in Claude Code and Codex. Commands are ABSOLUTE paths into the package: Claude Code copies the plugin to its cache on install, so plugin-root-relative escapes would dangle.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node /Users/firiya/oathe-playground/plugin/hooks/render-board.mjs",
            "timeout": 8
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node /Users/firiya/oathe-playground/plugin/hooks/heartbeat.mjs",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node /Users/firiya/oathe-playground/plugin/hooks/frame-note.mjs",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
