  "engines": {
    "node": ">=22"
  },
  "bin": {
    "oathe": "bin/oathe.mjs"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "link-runtime": "node scripts/link-runtime.mjs",
    "vendor-ddl": "node scripts/vendor-ddl.mjs",
    "marker-scan": "node scripts/marker-scan.mjs",
    "pack:dry-run": "npm pack --dry-run --ignore-scripts",
    "ci:policy": "node scripts/ci/check-workflows.mjs"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oathe-ai/oathe.git"
  },
  "homepage": "https://oathe.ai",
  "files": [
    ".claude-plugin/",
    "assets/",
    "bin/",
    "src/",
    "plugin/",
    "vendor/",
    "docs/PRIVACY.md",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "dependencies": {
    "pg": "^8.23.0"
  }
}
