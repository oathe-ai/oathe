# AI working docs — plans, scratch analyses; never shipped, never committed
.ai-docs/

# Harness docs snapshot — pinned official docs per harness, re-pulled by
# scripts/pull-harness-docs.mjs; the web is the source of truth, never the repo
.harness-docs/

# monorepo-machine re-link artifacts (ruling R-E): oathe-runtime is not a declared
# dependency, so npm prunes these; `npm run link-runtime` recreates the symlink on monorepo
# machines, and it never rides a commit.
node_modules/oathe-runtime
node_modules/.bin/oathe-runtime-*

# local tooling state — never committed
.serena/
.oathe.json
.DS_Store

# web-scrape scratch — never tracked, never shipped
.firecrawl/
